---
{"dg-publish":true,"permalink":"/non.canvas/","contentClasses":"canvas-page","dg-note-properties":{}}
---

<div id="noncanvas" class="canvas-wrapper hide">
	<svg class="canvas-background">
		<defs>
			<pattern id="canvas-grid-noncanvas" width="25" height="25" patternUnits="userSpaceOnUse">
				<circle r="1.5" cx="12.5" cy="12.5"></circle>
			</pattern>
		</defs>
		<rect width="100%" height="100%" fill="url(#canvas-grid-noncanvas)"></rect>
	</svg>
	<div class="canvas">
		<svg class="canvas-edges-container" style="position:absolute;width:1px;height:1px;overflow:visible;">
			<defs><filter x="-0.1" y="-0.1" width="1.2" height="1.3" id="edge-label-bg">
			<feFlood flood-color="var(--background-primary)" flood-opacity="1" result="bg"/>
			<feMerge>
				<feMergeNode in="bg"/>
				<feMergeNode in="SourceGraphic"/>
			</feMerge>
		</filter></defs>
		</svg>
		<div class="canvas-node canvas-node-file " data-node-id="f2f7f9ca2674ace4" data-file-path="01M1YQ7888B9KRFNB9222002MM.mov" style="transform: translate(-560px, -220px); width: 400px; height: 225px; ">
	<div class="canvas-node-label">01M1YQ7888B9KRFNB9222002MM.mov</div>
	<div class="canvas-node-container">
		<div class="canvas-node-content markdown-embed">
			<iframe src="/01-m1-yq-7888-b9-krfnb-9222002-mm//" class="canvas-file-iframe" loading="lazy"></iframe>
		</div>
	</div>
</div>
